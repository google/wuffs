// BLOCK_COUNT_BASE and BLOCK_COUNT_EXTRA give the block count code's base
// value and number of extra bits, as per RFC 7932 section 6.
pri const BLOCK_COUNT_BASE : roarray[26] base.u32[..= 16625] = [
        1, 5, 9, 13, 17, 25, 33, 41, 49, 65, 81, 97, 113,
        145, 177, 209, 241, 305, 369, 497, 753, 1265, 2289, 4337, 8433, 16625,
]

