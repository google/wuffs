// RFC 7932's constant tables. They are written by hand, except for the two
// regions marked "BEGIN generated" and "END generated", which a generator
// (not part of this package) writes from RFC 7932's text. The
// static dictionary itself is in common_dictionary.wuffs.

// CL_ORDER is the order in which a complex prefix code's code length code
// lengths appear, as per RFC 7932 section 3.5.
pri const CL_ORDER : roarray[18] base.u8[..= 17] = [
        1, 2, 3, 4, 0, 5, 17, 6, 16, 7, 8, 9, 10, 11, 12, 13, 14, 15,
]

// CLCL_SYMBOL and CLCL_LENGTH decode the static variable-length code for code
// length code lengths (RFC 7932 section 3.5), indexed by the next 4 bits.
pri const CLCL_SYMBOL : roarray[16] base.u8[..= 5] = [
        0, 4, 3, 2, 0, 4, 3, 1, 0, 4, 3, 2, 0, 4, 3, 5,
]

pri const CLCL_LENGTH : roarray[16] base.u8[..= 4] = [
        2, 2, 2, 3, 2, 2, 2, 4, 2, 2, 2, 3, 2, 2, 2, 4,
]

// CONTEXT_P2_COUNT[mode] is 1 + the largest CONTEXT_LUT value for p2 (the
// second half of mode's 512 entries): 1, 1, 4 and 8 for LSB6, MSB6, UTF8 and
// Signed. prepare_literal_block fills lit_ctx_tree for that many p2 values.
pri const CONTEXT_P2_COUNT : roarray[4] base.u8[..= 8] = [
        1, 1, 4, 8,
]

